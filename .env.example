# Copy to .dev.vars for local-only Pages development. Never commit real values.
DNS_PANEL_PASSWORD=replace-with-a-long-unique-password
DNS_PANEL_SESSION_SECRET=replace-with-at-least-32-random-characters
DNS_PANEL_SESSION_MAX_AGE_SECONDS=28800

# Configure one or more complete DNSHE credential pairs. Aliases are display-only.
DNSHE_KEY_1=replace-with-dnshe-api-key
DNSHE_SECRET_1=replace-with-dnshe-api-secret
DNSHE_ALIAS_1=Primary account
# DNSHE_KEY_2=replace-with-dnshe-api-key
# DNSHE_SECRET_2=replace-with-dnshe-api-secret
# DNSHE_ALIAS_2=Secondary account

# Set only while diagnosing non-sensitive server metadata. Sensitive values stay redacted.
DEBUG=false
